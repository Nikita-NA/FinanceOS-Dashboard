# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev (Nest on host, Postgres on host or mapped 5432): use localhost.
# docker-compose sets DATABASE_URL inside the api container automatically (host is `postgres`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_db"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long, random value in production
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
# Access token lifetime (e.g. 7d, 24h, 3600s) — used by AuthModule
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Single origin (e.g. https://myapp.com) or * — see main.ts enableCors
CORS_ORIGIN="*"
